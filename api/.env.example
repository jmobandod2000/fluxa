APP_MODE=dev

# HOSTNAME
HOST=http://localhost:3020/api
PORT=3020

# AUTHENTICATION
JWT_SECRET=CAMBIAR_POR_SECRETO_LARGO
JWT_EXPIRES_IN=12h

# ADMINISTRADOR INICIAL (se crea al arrancar si la base no tiene usuarios)
LOGIN_NAME=Administrador
LOGIN_EMAIL=admin@fluxa.local
LOGIN_PASSWORD=CAMBIAR_Abc123

# PRISMA
DATABASE_URL="postgresql://fluxa:CAMBIAR_PASSWORD_DB@127.0.0.1:5438/fluxa_db?schema=public"

# DOCKER COMPOSE (POSTGRESQL)
DB_PS_DATABASE=fluxa_db
DB_PS_USERNAME=fluxa
DB_PS_PASSWORD=CAMBIAR_PASSWORD_DB
DB_PS_PORT=5438
DB_PS_DOCKER_PORT=5432
DB_PS_DOCKER_VOLUME=./postgres-data

# CORREO (opcional): avisos al solicitante del portal
# URL pública de la app, usada en los enlaces de los correos
APP_URL=http://localhost:9020
# Para pruebas locales: docker compose --profile mail up -d  (buzón en http://localhost:8025)
SMTP_HOST=
# Ejemplo local con Mailpit: SMTP_HOST=127.0.0.1 y SMTP_PORT=1025
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Fluxa <soporte@tuempresa.com>
