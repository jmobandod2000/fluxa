{
  "name": "fluxa-web",
  "version": "0.1.0",
  "description": "Fluxa: sistema de turnos y filas de espera open source y autoalojado",
  "productName": "Fluxa",
  "type": "module",
  "private": true,
  "author": "Juan M. Obando",
  "license": "Apache-2.0",
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "typecheck": "vue-tsc --noEmit",
    "dev": "quasar dev",
    "build": "quasar build",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@quasar/extras": "^1.17.0",
    "@tanstack/vue-query": "^5.64.2",
    "axios": "^1.7.9",
    "dayjs": "^1.11.13",
    "exceljs": "4.4.0",
    "pinia": "^2.3.1",
    "quasar": "^2.18.1",
    "vue": "^3.5.13",
    "vue-i18n": "11.1.12",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@quasar/app-vite": "^2.2.1",
    "@types/node": "^20.5.9",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.30.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "typescript": "~5.9.3",
    "vite-plugin-checker": "^0.8.0",
    "vue-tsc": "^2.0.29"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20",
    "npm": ">= 6.13.4"
  }
