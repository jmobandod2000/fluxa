# Turnos — configuración de producción (docker compose).
# Recomendado: ./turnos install genera este archivo con contraseñas seguras.

# Puerto donde se abre Turnos (http://servidor:8081)
TURNOS_PORT=8081
# 0.0.0.0 = toda la red; 127.0.0.1 = solo este equipo (si usas un proxy con HTTPS delante)
TURNOS_BIND=0.0.0.0
# Versión de la imagen (latest o una fija, por ejemplo 1.0.0)
TURNOS_VERSION=latest
# Dirección pública de Turnos, usada en los enlaces de los correos
APP_URL=http://localhost:8081
# Zona horaria (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=America/Caracas

# Base de datos (solo letras y números en la contraseña)
DB_NAME=turnos
DB_USER=turnos
DB_PASSWORD=CAMBIAR_password_db

# Sesiones: texto aleatorio de al menos 32 caracteres
JWT_SECRET=CAMBIAR_por_un_texto_largo_y_aleatorio
JWT_EXPIRES_IN=12h

# Administrador inicial (se crea solo la primera vez, con la base vacía)
LOGIN_NAME=Administrador
LOGIN_EMAIL=admin@tuempresa.com
LOGIN_PASSWORD=CAMBIAR_Abc123

# Correo (opcional): avisos al solicitante del portal
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Turnos <soporte@tuempresa.com>

# Acceso a PostgreSQL desde este equipo (TablePlus, DBeaver): lo activa `turnos config`,
# que genera docker-compose.override.yml publicando la base solo en 127.0.0.1
DB_EXPOSE_PORT=

# Aviso de nuevas versiones en la app (consulta GitHub cada 12 h). false en redes sin Internet
UPDATE_CHECK=true
